# ==========================================
# 🟢 SUPABASE CONFIGURATION (Database & Storage - Miễn phí 100%)
# Lấy từ Project Settings -> API của dự án Supabase của bạn
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==========================================
# 📱 LOCKET OFFICIAL API (Mặc định chính thức của Locket)
# ==========================================
VITE_LOCKET_API_URL=https://api.locketcamera.com

# ==========================================
# 🔔 TÙY CHỌN BỔ SUNG (NẾU DÙNG)
# ==========================================
# VAPID Key cho Web Push Notifications (Tùy chọn)
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile Captcha (Tùy chọn)
VITE_TURNSTILE_SITE_KEY=